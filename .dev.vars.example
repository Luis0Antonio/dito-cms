# Better Auth signing secret. OPTIONAL.
#
# If unset, the worker auto-generates one and stores it in the D1 `settings` table —
# so the Deploy-to-Cloudflare button works with zero configuration. Set this explicitly
# for production (e.g. `wrangler secret put BETTER_AUTH_SECRET`) if you want to control
# the secret or rotate it. A set env value always wins over the stored fallback.
#
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudinary credentials. OPTIONAL — selects the media storage backend.
#
# If set, ALL media (images + video) is stored on Cloudinary and NO R2 bucket is needed.
# If unset, media uses the Cloudflare R2 bucket bound as `MEDIA` (the default). You only ever
# configure one — the other never blocks deployment. Copy this value verbatim from the
# Cloudinary Console → Settings → API Keys ("API environment variable", without the leading
# `CLOUDINARY_URL=`). For a deployed Worker set it as a secret instead:
#   wrangler secret put CLOUDINARY_URL
CLOUDINARY_URL=

# Store secret-encryption key. OPTIONAL — needed only for the commerce module.
#
# Encrypts payment-provider secrets (the Culqi secret key) and the order-hook auth header
# at rest in the D1 `settings` table. Content-only and catalog-only instances never need it;
# it is required only once you configure a payment gateway or an order-hook credential. Must be
# 32 random bytes, standard-base64-encoded. For a deployed Worker set it as a secret instead:
#   wrangler secret put SETTINGS_ENC_KEY
#
# Generate one with: openssl rand -base64 32
SETTINGS_ENC_KEY=
